<?xml version="1.0" encoding="utf-8"?>
<!--
    Recessed Scrubber Groove Well + Progress Fill
    - Background: recessed well (neo_well #E8EEF6)
    - Progress: electric blue gradient
    - Fully rounded pill (9999dp radius)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="9999dp" />
            <solid android:color="@color/neo_well" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="9999dp" />
                <gradient
                    android:startColor="@color/neo_accent"
                    android:endColor="@color/neo_accent_dark"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
