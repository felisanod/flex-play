<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="5dp" android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/neo_shadow_dark" />
        </shape>
    </item>
    <item android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/neo_shadow_light" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#3B82F6"
                android:endColor="#2563EB"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
