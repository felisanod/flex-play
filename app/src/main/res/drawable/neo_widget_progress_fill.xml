<?xml version="1.0" encoding="utf-8"?>
<!--
    Progress Fill Bar
    - Solid Electric Blue (#2563eb per spec, or neo_accent_dark)
    - Gradient for visual appeal
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="9999dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/neo_accent"
        android:endColor="@color/neo_accent_dark" />
</shape>
