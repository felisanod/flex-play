<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:padding="8dp"
    android:background="@color/neo_bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/neo_widget_panel">

        <!-- LEFT: Album artwork with horizontal fade -->
        <ImageView
            android:id="@+id/notification_artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/neo_widget_artwork_fade" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Top row: Info and Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/notification_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:textColor="@color/neo_text_primary" />

                    <TextView
                        android:id="@+id/notification_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="@color/neo_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/notification_btn_like"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="7dp"
                        android:src="@drawable/neo_ic_heart_outline"
                        android:background="@drawable/neo_widget_button" />

                    <ImageButton
                        android:id="@+id/notification_btn_prev"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:padding="7dp"
                        android:src="@drawable/neo_ic_skip_previous"
                        android:background="@drawable/neo_widget_button" />

                    <ImageButton
                        android:id="@+id/notification_btn_play_pause"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:padding="8dp"
                        android:src="@drawable/neo_ic_pause"
                        android:background="@drawable/neo_widget_button_primary" />

                    <ImageButton
                        android:id="@+id/notification_btn_next"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:padding="7dp"
                        android:src="@drawable/neo_ic_skip_next"
                        android:background="@drawable/neo_widget_button" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom row: Progress Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/notification_time_curr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="@color/neo_text_muted" />

                <ProgressBar
                    android:id="@+id/notification_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:progressDrawable="@drawable/neo_widget_progress_track" />

                <TextView
                    android:id="@+id/notification_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="@color/neo_text_muted" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
