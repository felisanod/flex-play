<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <!-- Outer neomorph panel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/neo_widget_panel">

        <!-- LEFT: Album artwork (absolute, faded) -->
        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="start|top"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- RIGHT-FACING GRADIENT MASK overlay so artwork fades into panel -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/neo_widget_artwork_fade_4x1" />

        <!-- CONTENT ROW (sits above the artwork) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <!-- Left offset spacer for the album art focal point -->
            <FrameLayout
                android:layout_width="74dp"
                android:layout_height="match_parent" />

            <!-- MIDDLE: Song info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingEnd="12dp"
                android:paddingStart="0dp">

                <TextView
                    android:id="@+id/widget_now_playing_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● NOW PLAYING"
                    android:textSize="9sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:textColor="@color/neo_accent" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:textColor="@color/neo_text_primary" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/neo_text_secondary" />

                <!-- Mini progress bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ProgressBar
                        android:id="@+id/widget_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/neo_widget_progress_track" />

                    <TextView
                        android:id="@+id/widget_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textSize="8sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/neo_text_muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- RIGHT: Control cluster -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/widget_btn_like"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="7dp"
                    android:src="@drawable/neo_ic_heart_outline"
                    android:background="@drawable/neo_widget_button"
                    android:contentDescription="@string/action_like" />

                <ImageButton
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:padding="7dp"
                    android:src="@drawable/neo_ic_skip_previous"
                    android:background="@drawable/neo_widget_button"
                    android:contentDescription="@string/previous_track" />

                <ImageButton
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:src="@drawable/neo_ic_pause"
                    android:background="@drawable/neo_widget_button_primary"
                    android:contentDescription="@string/play_pause" />

                <ImageButton
                    android:id="@+id/widget_btn_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:padding="7dp"
                    android:src="@drawable/neo_ic_skip_next"
                    android:background="@drawable/neo_widget_button"
                    android:contentDescription="@string/next_track" />

                <ImageButton
                    android:id="@+id/widget_btn_repeat"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:padding="7dp"
                    android:src="@drawable/neo_ic_repeat"
                    android:background="@drawable/neo_widget_button"
                    android:contentDescription="@string/repeat" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
